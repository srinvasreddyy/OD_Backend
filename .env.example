PORT=3000
NODE_ENV=development

# --- DATABASE ---
MONGODB_URI=

# --- SECURITY ---
JWT_SECRET=super_secret_key_here
JWT_EXPIRY=24h

# --- FRONTEND URLS ---
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
CLIENT_SUCCESS_REDIRECT_URL="http://localhost:5173/dashboard"
CLIENT_FAILURE_REDIRECT_URL="http://localhost:5173/login"
CLIENT_RESTAURANT_URL="http://localhost:5174"

# --- STRIPE PAYMENTS (CONNECT) ---
STRIPE_SECRET_KEY=

# [IMPORTANT] Replace with the secret starting with 'whsec_' from your Stripe Dashboard > Webhooks
STRIPE_WEBHOOK_SECRET= 

# [IMPORTANT] Replace with the Connect secret starting with 'whsec_' from your Stripe Dashboard > Webhooks
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- GOOGLE OAUTH ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=GOCSPX-
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- EXTERNAL SERVICES ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_USER=
EMAIL_PASS=

# --- FEATURE FLAGS ---
ENABLE_OFFERS=true
ENABLE_BOOKING_LOCKS=true
ENABLE_IDEMPOTENCY_CHECK=true
ENABLE_SUPER_ADMIN_REGISTRATION=true

# --- SUPER ADMIN ---
SUPER_ADMIN_EMAIL=skillswap.org@gmail.com
SUPER_ADMIN_FULL_NAME=SUPER ADMIN
SUPER_ADMIN_PASSWORD=a-very-secure-password123

PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=50

# Backend .env
# Set to 'false' to immediately disable Stripe & force COD everywhere.
ENABLE_ONLINE_PAYMENTS=false
